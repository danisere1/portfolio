---
import './src/styles/global.css';
import '@fontsource-variable/onest';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	// Define any props you want to pass to the layout here
	title: string;
}
const { title } = Astro.props as Props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/Logo_32x32.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{ title }</title>
	</head>
	<body class="bg-radial from-surface-gradient-2 via-surface-gradient-1 to-surface-dark text-text-main flex flex-col min-h-screen">
		<Header/>
		<main class="flex-grow flex flex-col items-center justify-center">
			<slot/>
        </main>
		<Footer/>
	</body>
</html>

<style is:global>
	html{
		font-family: "Onest", sans-serif;
	}
</style>