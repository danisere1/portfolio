---
import '../styles/global.css';
import '@fontsource-variable/onest';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	// Define any props you want to pass to the layout here
	title: string;
}
const { title } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/Logo_32x32.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{ title }</title>
	</head>
	<body class="relative isolate bg-radial from-surface-gradient-2 via-surface-gradient-1 to-surface-dark text-text-main flex flex-col min-h-screen">
		<div class="scroll-backdrop" aria-hidden="true">
			<span class="scroll-backdrop__orb scroll-backdrop__orb--violet"></span>
			<span class="scroll-backdrop__orb scroll-backdrop__orb--blue"></span>
			<span class="scroll-backdrop__orb scroll-backdrop__orb--pink"></span>
			<span class="scroll-backdrop__ring"></span>
		</div>
		<Header/>
		<main class="relative z-10 flex-grow flex flex-col items-center justify-center">
			<slot/>
        </main>
		<div class="relative z-10">
			<Footer/>
		</div>
		<script>
			const revealItems = document.querySelectorAll<HTMLElement>('.scroll-reveal');
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if ('IntersectionObserver' in window && !prefersReducedMotion) {
				document.documentElement.classList.add('scroll-reveal-enabled');

				const revealObserver = new IntersectionObserver((entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
						} else {
							entry.target.classList.remove('is-visible');
						}
					}
				}, {
					threshold: 0.12,
					rootMargin: '0px 0px -40px 0px',
				});

				revealItems.forEach((item) => revealObserver.observe(item));
			}

			const sectionLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section]');
			const sections = ['#home', '#experience', '#projects', '#studies', '#contact']
				.map((id) => document.querySelector<HTMLElement>(id))
				.filter((section): section is HTMLElement => section !== null);

			const updateActiveSection = () => {
				const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
				const progress = Math.min(Math.max(window.scrollY / maxScroll, 0), 1);
				// La línea de detección baja con el scroll para que las últimas secciones sean alcanzables en cualquier pantalla.
				const line = window.innerHeight * Math.max(0.35, progress);
				let current = sections[0];

				for (const section of sections) {
					if (section.getBoundingClientRect().top <= line) {
						current = section;
					}
				}

				sectionLinks.forEach((link) => {
					link.classList.toggle('is-active', link.dataset.section === `#${current.id}`);
				});
			};

			let ticking = false;
			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updateActiveSection();
					ticking = false;
				});
			};

			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onScroll);
			updateActiveSection();
		</script>
	</body>
</html>

<style is:global>
	html{
		font-family: "Onest", sans-serif;
		scroll-behavior: smooth;
	}

	.scroll-reveal {
		transition:
			opacity 650ms ease,
			translate 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	html.scroll-reveal-enabled .scroll-reveal:not(.is-visible) {
		opacity: 0;
		translate: 0 28px;
	}

	.experience-list .scroll-reveal:nth-child(2),
	.project-list .scroll-reveal:nth-child(2),
	.studies-list .scroll-reveal:nth-child(3) {
		transition-delay: 100ms;
	}

	.experience-list .scroll-reveal:nth-child(3),
	.project-list .scroll-reveal:nth-child(3),
	.studies-list .scroll-reveal:nth-child(4) {
		transition-delay: 180ms;
	}

	.scroll-backdrop {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.scroll-backdrop::before,
	.scroll-backdrop::after {
		position: absolute;
		inset: 0;
		content: "";
	}

	.scroll-backdrop::before {
		background-image:
			linear-gradient(rgb(255 255 255 / 2.5%) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 2.5%) 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: radial-gradient(ellipse at center, black, transparent 78%);
	}

	.scroll-backdrop::after {
		background: radial-gradient(ellipse at center, transparent 30%, rgb(7 6 18 / 38%) 100%);
	}

	.scroll-backdrop__orb {
		position: absolute;
		display: block;
		width: min(44vw, 620px);
		aspect-ratio: 1;
		border-radius: 50%;
		filter: blur(72px);
		opacity: 0.62;
		will-change: transform;
	}

	.scroll-backdrop__orb--violet {
		top: -16%;
		left: -14%;
		background: radial-gradient(circle, rgb(126 57 235 / 78%), transparent 68%);
	}

	.scroll-backdrop__orb--blue {
		top: 33%;
		right: -19%;
		width: min(40vw, 560px);
		background: radial-gradient(circle, rgb(40 107 237 / 62%), transparent 69%);
	}

	.scroll-backdrop__orb--pink {
		bottom: -43%;
		left: 24%;
		width: min(48vw, 680px);
		background: radial-gradient(circle, rgb(194 49 166 / 50%), transparent 70%);
	}

	.scroll-backdrop__ring {
		position: absolute;
		top: 34%;
		left: 61%;
		width: min(38vw, 520px);
		aspect-ratio: 1;
		border: 1px solid rgb(255 255 255 / 9%);
		border-radius: 50%;
		box-shadow: 0 0 90px rgb(124 58 237 / 9%), inset 0 0 90px rgb(124 58 237 / 7%);
		will-change: transform;
	}

	@supports (animation-timeline: scroll()) {
		.scroll-backdrop__orb--violet {
			animation: drift-violet 1s linear both;
			animation-timeline: scroll(root block);
			animation-range: 0% 100%;
		}

		.scroll-backdrop__orb--blue {
			animation: drift-blue 1s linear both;
			animation-timeline: scroll(root block);
			animation-range: 0% 100%;
		}

		.scroll-backdrop__orb--pink {
			animation: drift-pink 1s linear both;
			animation-timeline: scroll(root block);
			animation-range: 0% 100%;
		}

		.scroll-backdrop__ring {
			animation: drift-ring 1s linear both;
			animation-timeline: scroll(root block);
			animation-range: 0% 100%;
		}
	}

	@keyframes drift-violet {
		from { transform: translate3d(0, -6vh, 0) scale(0.92); }
		to { transform: translate3d(8vw, 38vh, 0) scale(1.18); }
	}

	@keyframes drift-blue {
		from { transform: translate3d(0, 12vh, 0) scale(1.12); }
		to { transform: translate3d(-15vw, -35vh, 0) scale(0.88); }
	}

	@keyframes drift-pink {
		from { transform: translate3d(-8vw, 15vh, 0) scale(0.9); }
		to { transform: translate3d(12vw, -48vh, 0) scale(1.2); }
	}

	@keyframes drift-ring {
		from { transform: translate3d(0, 8vh, 0) rotate(-18deg) scale(0.8); }
		to { transform: translate3d(-30vw, -22vh, 0) rotate(36deg) scale(1.16); }
	}

	@media (max-width: 768px) {
		.scroll-backdrop__orb {
			width: 78vw;
			filter: blur(56px);
		}

		.scroll-backdrop__ring {
			left: 34%;
			width: 62vw;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		.scroll-reveal {
			transition: none;
		}

		.scroll-backdrop__orb,
		.scroll-backdrop__ring {
			animation: none !important;
		}
	}
</style>