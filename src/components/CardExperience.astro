---
import CardTitle from './CardTitle.astro';
import { parseHighlights  } from '../lib/highlightParser';
import Highlight from './Highlight.astro';

interface Props {
  title: string;
  description: string;
  start_date: Date;
  finish_date: Date | null;
  company: string;
}

const { title, description, start_date, finish_date, company } = Astro.props as Props;
const parts = parseHighlights (description);
---

<article class="pl-7 pr-7 pt-7 pb-7 flex flex-col items-center justify-center bg-white/3 backdrop-blur-md rounded-2xl border border-white/20 shadow-md hover:border-button hover:shadow-lg scale-100 transition-all duration-700 ease-in-out w-full card-hover-effect">

    <div class="pb-5 gap-2 flex flex-col items-center justify-between">
        <CardTitle>
            { title } - { company }
        </CardTitle>
        <p class="font-bold">
            From {start_date} to {finish_date ? finish_date : 'Present'}
        </p>
    </div>
    <p class="pb-3">
        {parts.map((part) =>
            typeof part === 'string' ? part : <Highlight>{part.highlight}</Highlight>
        )}
    </p>

</article>