---
import HeaderButton from './HeaderButton.astro';
import Logo from "../assets/Logo.png";
---

<header 
class="sticky top-0 z-50 flex justify-between items-center w-full h-25 backdrop-blur bg-transparent shadow-lg shadow-purple-800"
>
    <img src={Logo.src} alt="Logo" class="w-16 h-16 ml-10"/>
    <nav class="flex flex-row gap-x-10 opacity-90 px-50 flex-wrap ml-auto pt-3 pb-3">
        <HeaderButton href="#experience">
            Experience
        </HeaderButton>
        <HeaderButton href="#projects">
            Projects
        </HeaderButton>
        <HeaderButton href="#studies">
            Studies
        </HeaderButton>
        <HeaderButton href="#contact">
            Contact
        </HeaderButton>
    </nav>
    <div class="absolute left-0 right-0 -bottom-0 h-0.5 bg-white rounded-full opacity-40"></div>
</header>