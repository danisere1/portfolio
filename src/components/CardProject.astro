---
interface Props {
  title: string;
  description: string;
  github: string | null;
  image_url: string | null;
}

const { title, description, github, image_url } = Astro.props as Props;
---

<article class="pl-7 pr-7 pt-7 pb-7 flex flex-col items-center justify-center bg-white/3 backdrop-blur-md rounded-2xl border border-white/20 shadow-md hover:border-button hover:shadow-lg hover:scale-110 scale-100 transition-all duration-700 ease-in-out w-4/12 card-hover-effect">

    <h1>{ title }</h1>
    <p>{ description }</p>
    {github && github !== "null" && github !== "" && (
        <a href={ github }>github</a>
    )}
    {image_url && image_url !== "null" && image_url !== "" && (
        <img src={ image_url } alt="Imagen del proyecto" />
    )}

</article>