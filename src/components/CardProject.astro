---
import CardTitle from './CardTitle.astro';
import { parseHighlights  } from '../lib/highlightParser';
import Highlight from './Highlight.astro';

interface Props {
  title: string;
  description: string;
  github: string | null;
  image_url: string | null;
}

const { title, description, github, image_url } = Astro.props as Props;
const parts = parseHighlights (description);
---

<article class="pl-7 pr-7 pt-7 pb-7 flex flex-col items-center justify-center bg-white/3 backdrop-blur-md rounded-2xl border border-white/20 shadow-md hover:border-button hover:shadow-lg hover:scale-110 scale-100 transition-all duration-700 ease-in-out w-4/12 card-hover-effect">

    <div class="pb-5 gap-2 flex flex-row items-center justify-between">
        <CardTitle>
            { title }
        </CardTitle>
        {github && github !== "null" && github !== "" && (
        <a href={ github }><svg  xmlns="http://www.w3.org/2000/svg"  width="20"  height="20"  viewBox="0 0 24 24"  fill="none"  stroke="#854198"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-external-link"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /><path d="M11 13l9 -9" /><path d="M15 4h5v5" /></svg></a>
        )}
    </div>
    <p class="pb-3">
        {parts.map((part) =>
            typeof part === 'string' ? part : <Highlight>{part.highlight}</Highlight>
        )}
    </p>
    {image_url && image_url !== "null" && image_url !== "" && (
        <img src={ image_url } alt="Imagen del proyecto" />
    )}

</article>