---
import { supabase } from '../lib/supabase';
import Title from './Title.astro';

const { data: studies } = await supabase
  .from('studies')
  .select('*');
---
<div id="studies" class="scroll-mt-28 pb-40 gap-10 flex flex-col items-center justify-center w-9/12 max-w-3xl">
    <Title>Studies and Certifications</Title>
    <ol class="studies-list relative flex w-full flex-col gap-5 pl-8 sm:pl-10">
        <span class="absolute bottom-3 left-[0.6rem] top-3 w-px bg-gradient-to-b from-violet-400/60 via-violet-400/25 to-transparent sm:left-[0.85rem]" aria-hidden="true"></span>
        {
            studies?.map(study => (
                <li class="scroll-reveal content-panel relative flex items-center gap-4 p-5 sm:p-6">
                    <span class="absolute -left-[1.62rem] top-1/2 h-3 w-3 -translate-y-1/2 rounded-full bg-violet-400 shadow-[0_0_16px_4px_rgba(139,92,246,0.55)] sm:-left-[1.95rem]" aria-hidden="true"></span>
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-violet-400/10 text-violet-200" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 9l-10 -4l-10 4l10 4l10 -4v6" /><path d="M6 10.6v5.4a6 3 0 0 0 12 0v-5.4" /></svg>
                    </span>
                    <div class="min-w-0">
                        <p class="text-base font-semibold leading-snug text-white sm:text-lg">{study.title}</p>
                        <p class="mt-1 text-sm text-violet-200/70">{study.school}</p>
                    </div>
                </li>
            ))
        }
    </ol>
</div>
