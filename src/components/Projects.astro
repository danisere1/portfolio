---
import { supabase } from '../lib/supabase';
import CardProject from './CardProject.astro';
import Title from './Title.astro';

const { data: projects } = await supabase
  .from('projects')
  .select('*');
---
<div id="projects" class="pb-40 gap-10 flex flex-col items-center justify-center w-9/12">
    <Title>Projects</Title>
    <div class="w-8/12 items-stretch justify-center grid grid-cols-1 md:grid-cols-2 gap-10">
        {
            projects?.map(project => (
                <CardProject
                    title={project.title}
                    description={project.description}
                    github={project.github}
                    image_url={project.image_url}
                />
            ))
        }
    </div>
</div>