---
import AboutButton from "./AboutButton.astro";
import Highlight from "./Highlight.astro";
import Me from "../assets/Me.png";
---

<div class="pb-40 pt-40 px-15 flex flex-col items-center justify-center w-9/12 h-full">
    <h1 class="text-5xl font-bold text-text-main text-center pb-10"
        style="text-shadow: 0 4px 24px #8541f8;">
        Daniel Sereno Fernadez
    </h1>
    <h2 class="text-4xl font-bold text-text-accent pb-5">
        Devops Engineer
    </h2>
    <h3 class="max-w-3xl text-xl font-bold text-text-main text-center">
        Automating the future, one pipeline at a time — empowering teams with efficient CI/CD workflows and intelligent infrastructure
    </h3>
    <section class="pt-30 flex flex-col lg:flex-row justify-center items-center w-full h-full gap-10">
        <figure class="flex-shrink-0 self-center w-120 flex justify-center items-center">
            <img src={Me.src} alt="Chico saludando" class="w-120 h-150"/>
        </figure>
        <div class="flex flex-col items-center justify-center w-4/12 pt-30 min-w-100">
            <nav class="pb-7 flex flex-row flex-wrap items-center justify-center w-full">
                <AboutButton href="https://kexlksljqibyfoawrajg.supabase.co/storage/v1/object/public/portfoliobucket/Curriculum%20Daniel%20Sereno%20Fernandez%20in.pdf">
                    <svg  xmlns="http://www.w3.org/2000/svg"  width="40"  height="40"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler about-button-hover icons-tabler-outline icon-tabler-file-cv"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><path d="M11 12.5a1.5 1.5 0 0 0 -3 0v3a1.5 1.5 0 0 0 3 0" /><path d="M13 11l1.5 6l1.5 -6" /></svg>
                </AboutButton>
                <AboutButton href="https://github.com/danisere1">
                    <svg  xmlns="http://www.w3.org/2000/svg"  width="40"  height="40"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon about-button-hover icon-tabler icons-tabler-outline icon-tabler-brand-github"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg>
                </AboutButton>
                <AboutButton href="https://www.linkedin.com/in/daniel-sereno-fern%C3%A1ndez-03780122b/">
                   <svg  xmlns="http://www.w3.org/2000/svg"  width="40"  height="40"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon about-button-hover icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 1 0 -4 0" /><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" /></svg>
                </AboutButton>
            </nav>
            <p class="pl-7 pr-7 pb-7 pt-7 bg-white/3 backdrop-blur-md rounded-2xl border border-white/20 shadow-md hover:shadow-lg hover:scale-110 scale-100 transition-all duration-700 ease-in-out w-10/12 card-hover-effect card-hover-color"> 
                Hello there👋, I am a DevOps Engineer focused on <Highlight>automation</Highlight>, <Highlight>continuous integration</Highlight> and efficient deployment pipelines.
                I have hands-on experience with tools like <Highlight>Jenkins</Highlight>, <Highlight>Docker</Highlight>, <Highlight>SonarQube</Highlight>, <Highlight>Artifactory</Highlight> and <Highlight>Bitbucket</Highlight>, creating <Highlight>CI/CD</Highlight> processes that streamline the software development lifecycle. I work primarily in <Highlight>AWS</Highlight> environments and I am currently pursuing <Highlight>AWS certifications</Highlight> to deepen my cloud experience. I'm passionate about <Highlight>infrastructure as code</Highlight>, <Highlight>observability</Highlight> and continuous improvement in cloud-native environments. I have a <Highlight>Master degree in Artificial Intelligence</Highlight>, a field I am passionate about.
            </p>
        </div>
    </section>
</div>