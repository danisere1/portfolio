---
import { supabase } from '../lib/supabase';
import CardExperience from './CardExperience.astro';
import Title from './Title.astro';

const { data: experiences } = await supabase
  .from('experiences')
  .select('*');
---
<div id="experience" class="pb-40 gap-10 flex flex-col items-center justify-center w-9/12">
    <Title>Experience</Title>
    <div class="w-5/12 items-center justify-center flex flex-col gap-10">
        {
            experiences?.map(experience => (
                <CardExperience
                    title={experience.title}
                    description={experience.description}
                    start_date={experience.start_date}
                    finish_date={experience.finish_date}
                    company={experience.company}
                />
            ))
        }
    </div>
</div>