---
import Title from './Title.astro';
---
<div id="contact" class="scroll-mt-28 pb-40 gap-10 flex flex-col items-center justify-center w-9/12 max-w-3xl">
    <Title>Contact me</Title>
    <article class="scroll-reveal content-panel contact-panel flex w-full flex-col items-center gap-8 p-8 text-center sm:p-12">
        <p class="max-w-xl text-xl font-semibold leading-snug text-white sm:text-2xl">
            Have a project or an opportunity in mind? <span class="text-text-accent">Let's talk.</span>
        </p>

        <div class="grid w-full gap-3 sm:grid-cols-2">
            <a href="mailto:danielserfer10@gmail.com" class="contact-item flex items-center gap-4 text-left">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-violet-400/10 text-violet-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>
                </span>
                <span class="min-w-0">
                    <span class="block text-xs font-semibold uppercase tracking-[0.18em] text-violet-200/70">Email</span>
                    <span class="mt-1 block break-all text-sm font-medium text-white">danielserfer10@gmail.com</span>
                </span>
            </a>
            <a href="tel:+34689664445" class="contact-item flex items-center gap-4 text-left">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-violet-400/10 text-violet-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" /></svg>
                </span>
                <span>
                    <span class="block text-xs font-semibold uppercase tracking-[0.18em] text-violet-200/70">Phone</span>
                    <span class="mt-1 block text-sm font-medium text-white">+34 689 66 44 45</span>
                </span>
            </a>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3">
            <a href="mailto:danielserfer10@gmail.com" class="contact-cta">Send an email</a>
            <a href="https://www.linkedin.com/in/daniel-sereno-fern%C3%A1ndez-03780122b/" target="_blank" rel="noreferrer" class="contact-cta contact-cta--ghost">LinkedIn</a>
            <a href="https://github.com/danisere1" target="_blank" rel="noreferrer" class="contact-cta contact-cta--ghost">GitHub</a>
        </div>
    </article>
</div>
